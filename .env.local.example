# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for admin operations (staff account creation, brief generation).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-only, used from API routes only)
ANTHROPIC_API_KEY=

# Shared secret checked by /api/brief/generate. Generate with: openssl rand -hex 32
CRON_SECRET=
